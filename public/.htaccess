RewriteEngine On

# Denegar acceso a archivos y directorios sensibles
RedirectMatch 404 /\.git
RedirectMatch 404 /config/
RedirectMatch 404 /app/
RedirectMatch 404 /core/
RedirectMatch 404 /helpers/
RedirectMatch 404 /middlewares/
RedirectMatch 404 /db/

# Si el archivo o directorio existe, no reescribir
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Redirigir todo a index.php
RewriteRule ^(.*)$ index.php [QSA,L]